# Server
BIND_ADDR=127.0.0.1:4242
ARCHIVE_DIR=./output

# Local Ollama (default). The native API lets the app request enough context
# for a normal long-form video instead of Ollama's common 4K default.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
LLM_CONTEXT_LENGTH=16384
# LLM_API_KEY=

# SiliconFlow / DeepSeek-V4-Flash (OpenAI-compatible). Uncomment this profile
# instead of the local Ollama values above, then set your SiliconFlow API key.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# SILICONFLOW_API_KEY=...

# OpenAI API (OpenAI-compatible). This needs an OpenAI Platform API key and
# API billing; a ChatGPT desktop or subscription login is not an API credential.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-...

# Optional email: all three values are required; otherwise email is skipped.
# RESEND_API_KEY=re_...
# RESEND_FROM=Archive <archive@example.com>
# RESEND_TO=you@example.com

# Comma-separated browser origins. Do not use *. Leave empty locally to allow
# Chrome extensions plus localhost:3000 and 127.0.0.1:3000.
# CORS_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
